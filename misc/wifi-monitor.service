[Unit]
Description=Setup monitoring device
Requires=sys-subsystem-net-devices-wlx984827ec6e9f.device
After=sys-subsystem-net-devices-wlx984827ec6e9f.device

[Service]
Type=simple
ExecStartPre=ip link set wlx984827ec6e9f down
ExecStartPre=iw wlx984827ec6e9f set type monitor
ExecStartPre=ip link set wlx984827ec6e9f up
ExecStart=/bin/sh -c 'while true; do for c in `seq 1 13`; do iw dev wlx984827ec6e9f set channel $c; sleep 1s; done; done'

[Install]
WantedBy=sys-subsystem-net-devices-wlx984827ec6e9f.device
