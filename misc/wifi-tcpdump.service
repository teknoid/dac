[Unit]
Description=Run tcpdump on monitoring device
Wants=network-online.target
After=network-online.target wifi-monitor.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'tcpdump -nevi mon0 | nc tron 6666'
ExecStop=killall tcpdump
Restart=always
RestartSec=30
User=hje

[Install]
WantedBy=multi-user.target

